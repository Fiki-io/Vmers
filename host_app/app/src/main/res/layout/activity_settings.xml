<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VM Configuration"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Feature Toggles -->
        <Switch
            android:id="@+id/sw_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Superuser (Root Access)"
            android:textColor="@color/text_white"
            android:checked="true"
            android:layout_marginBottom="16dp" />

        <Switch
            android:id="@+id/sw_gles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OpenGL ES Hardware Acceleration"
            android:textColor="@color/text_white"
            android:checked="true"
            android:layout_marginBottom="24dp" />

        <!-- Display Dimensions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Display Resolution &amp; DPI"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_res_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Width (e.g. 1080)"
            android:inputType="number"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_res_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Height (e.g. 2400)"
            android:inputType="number"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_dpi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="DPI (e.g. 420)"
            android:inputType="number"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:layout_marginBottom="24dp" />

        <!-- Identity Spoofer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device Identity Spoofing"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_fake_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Device Model (e.g. Pixel 9 Pro)"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save &amp; Apply to Container"
            android:backgroundTint="@color/primary"
            android:textColor="@color/text_white" />

    </LinearLayout>
</ScrollView>
