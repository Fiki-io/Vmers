<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1015"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Debugger &amp; Crash Terminal"
            android:textColor="#00CEC9"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_copy_logs"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Copy"
            android:textSize="12sp"
            android:backgroundTint="#00CEC9"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_clear_logs"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Clear"
            android:textSize="12sp"
            android:backgroundTint="#2D3436"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_export_logs"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Export"
            android:textSize="12sp"
            android:backgroundTint="#6C5CE7"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- Search & Filters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/et_search_log"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#1A1C23"
            android:hint="Search errors, SIGSEGV, denied, avc..."
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#636E72"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/spinner_log_level"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:background="#2D3436" />

    </LinearLayout>

    <!-- Terminal Log Output Area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_logcat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#08090C"
        android:padding="4dp" />

</LinearLayout>
